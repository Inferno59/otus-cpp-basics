namespace my_containers {

  template <typename T>
  Vector<T>::Vector()
    : size_{}
    , max_size_{kDefaultSize}
    , data_{nullptr} {
      // Резервируем стартовое пространство
      reserved(max_size_);      
    }

  template <typename T>
  Vector<T>::Vector(const T& value)
    : size_{}
    , max_size_{kDefaultSize}
    , data_{nullptr} {

      // Резервируем стартовое пространство
      reserved(max_size_);
      push_back(value);
    }

  template <typename T>
  Vector<T>::Vector(const T& value, size_t size)
    : size_{}
    , max_size_{get_max_size(size)}
    , data_{nullptr} {
      reserved(max_size_); 
      for(size_t i = 0; i < size; ++i) {
        push_back(value);
      }
    }
    
    template <typename T>
    Vector<T>::Vector(std::initializer_list<T> values) 
    : size_{}
    , max_size_{get_max_size(values.size())}
    , data_{nullptr} {

      reserved(max_size_); 

      for(auto& value : values)
        push_back(value);
    }    
    
  template <typename T>
  Vector<T>::~Vector() {
    clear();
  }
    
  template <typename T>
  std::size_t Vector<T>::size() const {
    return size_;
  }

  template <typename T>
  std::size_t Vector<T>::max_size() const {
    return max_size_;
  }

  template <typename T>
  void Vector<T>::push_back(const T& value) {
    if (size_ + 1  > max_size_ - 1) {
      max_size_ *= 2;
      resize(max_size_);
    }

    new (&data_[size_++]) T(std::move(value));
  }

  template <typename T>
  void Vector<T>::reserved(size_t size) {
    if (max_size_ < size)
      max_size_ = size;

    if (data_ != nullptr)
      resize(max_size_);
    else 
      data_ = allocate(max_size_);
  }

  template <typename T>
  T* Vector<T>::allocate(size_t size) {
    return static_cast<T*>(operator new(sizeof(T) * size));
  }
  
  template <typename T>
  void Vector<T>::resize(size_t size) {
    if (size_ > size_)
      throw std::out_of_range("Cannot shrink of vector");

    T* new_data = allocate(size);
    if (data_) {
      for(size_t i = 0; i < size_; ++i)
        new (&new_data[i]) T(std::move(data_[i]));

      clear_internal_memory();
    }

    data_ = new_data;  
    max_size_ = size;
  }  

  template <typename T>
  typename Vector<T>::iterator Vector<T>::erase(iterator& pos) {
    // Защита от невалидных итераторов
    if (pos < begin() || pos > end())
        throw std::out_of_range("Cannot erase. Iterator out of bounds");

    size_t erase_idx = static_cast<size_t>(pos - begin());
    erase(erase_idx);
    
    return iterator(&data_[erase_idx]);
  }

  template <typename T>
  void Vector<T>::erase(size_t pos) {
    if (size_ == 0 || pos >= size_)
      throw std::out_of_range("Cannot erase. Position out of bounds");

    shift_to_left_from_idx(pos);
    data_[size_ - 1].~T(); // Вызываем деструктор последнего объекта, чтоб не двоился
    --size_;
  }

  template <typename T>
  void Vector<T>::shift_to_left_from_idx(size_t idx) {
    for (size_t i = idx; i < size_ - 1; ++i)
      data_[i] = std::move(data_[i + 1]); // Перемещаем, сработает для базовых типов,  объектов с оператором перемещения и для тривиальных объектов
  }

  template <typename T>
  typename Vector<T>::iterator Vector<T>::insert(iterator& pos, const T& value) {
    // Защита от невалидных итераторов
    if (pos < begin() || pos > end())
        throw std::out_of_range("Cannot insert. Iterator out of bounds");

    size_t insert_idx = static_cast<size_t>(pos - begin());
    insert(insert_idx, value);

    return iterator(&data_[insert_idx]);
  }

  template <typename T>
  void Vector<T>::insert(size_t pos, const T& value) {
    if (pos > size_)
      throw std::out_of_range("Cannot insert. Position out of bounds");

    if (size_ + 1  > max_size_) {
      const size_t tmp_max_size_ = max_size_ * 2;
      T* new_data = allocate(tmp_max_size_);

      // Копируем элементы ДО позиции вставки
      for (size_t i = 0; i < pos; ++i)
        new (&new_data[i]) T(std::move(data_[i]));

      new (&new_data[pos]) T(std::move(value));

      // Копируем элементы ПОСЛЕ позиции вставки
      for (size_t i = pos; i < size_; ++i)
        new (&new_data[i + 1]) T(std::move(data_[i]));

      clear_internal_memory();

      data_ = new_data;      
      max_size_ = tmp_max_size_;
    } else {
      // Делаем смещение обьектов вправо
      shift_to_right_from_idx(pos);
      data_[pos].~T(); // Уничтожаем старый объект
      new (&data_[pos]) T(std::move(value));
    }

    ++size_;
  }

  template <typename T>
  void Vector<T>::shift_to_right_from_idx(size_t idx) {
    if (size_ == 0)
      return;

    // Последний живой элемент нужно скопировать в новую, пока еще пустую ячейку в конце
    new (&data_[size_]) T(std::move(data_[size_ - 1]));

    // Сдвигаем остальные элементы справа налево с помощью перемещения
    for (size_t i = size_ - 1; i > idx; --i) {
        data_[i] = std::move(data_[i - 1]);
    }
  }

  template <typename T>
  void Vector<T>::clear() {
    clear_internal_memory();
    size_ = 0;
    max_size_ = 0;
  }

  template <typename T>
  void Vector<T>::pop_back() {
    if (size_ == 0)
      return;

    data_[size_ - 1].~T();

    --size_;
  }

  template <typename T>
  void Vector<T>::clear_internal_memory() {
    if (data_ == nullptr)
      return;

    for(size_t i = 0; i < size_; ++i) {
      data_[i].~T();
    }
    operator delete(data_);
  }


  template <typename T>
  Vector<T>::Vector(const Vector<T>& src) 
    : size_{src.size()}
    , max_size_{src.max_size()}
    , data_{allocate(max_size_)} {

    for (size_t i = 0; i < size_; ++i)
      new (&data_[i]) T(std::move(src[i]));

    std::cout << "Copy vector ctor" << std::endl;
  }

  template <typename T>
  Vector<T>::Vector(Vector<T>&& src)
    : size_{src.size()}
    , max_size_{src.max_size()}
    , data_{src.data_} {

    src.data_ = nullptr;
    src.size_ = 0;
    src.max_size_ = 0;

    std::cout << "Move vector ctor" << std::endl;
  }

  template <typename T>
  Vector<T>& Vector<T>::operator=(const Vector<T>& src) {
    if (this == &src)
      return *this;

    T* new_data = allocate(src.max_size());

    for (size_t i = 0; i < src.size(); ++i)
      new (&new_data[i]) T(std::move(src.data_[i]));    

    clear();

    size_ = src.size();
    max_size_ = src.max_size();
    data_ = new_data;

    std::cout << "Copy vector operator" << std::endl;

    return *this;
  }
  template <typename T>
  Vector<T>& Vector<T>::operator=(Vector<T>&& src) {
    clear();
    data_ = src.data_;
    size_ = src.size_;
    max_size_ = src.max_size_;

    src.data_ = nullptr;
    src.size_ = 0;
    src.max_size_ = 0;

    std::cout << "Move vector operator" << std::endl;
    return *this;
  }
}