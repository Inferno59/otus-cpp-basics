#include "vector.hpp"

namespace my_containers{
  template <typename T>
  Vector<T>::Vector()
    : size_{}
    , max_size_{kDefaultSize}
    , data{nullptr} {
      // Резервируем стартовое пространство
      resize(max_size_);      
    }

  template <typename T>
  Vector<T>::Vector(const T& value)
    : size_{}
    , max_size_{kDefaultSize}
    , data{nullptr} {

      // Резервируем стартовое пространство
      resize(max_size_);
      push_back(value);
    }

  template <typename T>
  Vector<T>::Vector(const T& value, size_t size)
    : size_{}
    , max_size_{get_max_size(size)}
    , data{nullptr} {
      resize(max_size_); 
      for(size_t i = 0; i < size; ++i) {
        push_back(value);
      }
        
    }
    
    template <typename T>
    Vector<T>::Vector(std::initializer_list<T> values) 
    : size_{}
    , max_size_{get_max_size(values.size())}
    , data{nullptr} {

      resize(max_size_); 

      for(auto& value : values)
        push_back(value);
    }    
    
  template <typename T>
  std::size_t Vector<T>::size() const {
    return size_;
  }

  template <typename T>
  std::size_t Vector<T>::max_size() const {
    return max_size_;
  }  

  template <typename T>
  void Vector<T>::push_back(const T& value) {
    if (size_ + 1  > max_size_ - 1) {
      max_size_ *= 2.0;
      resize(max_size_);
    }

    std::cout << "push_back: " << size_ << std::endl;
    data[size_++] = value;
  }

  template <typename T>
  void Vector<T>::resize(size_t size) {
    std::cout << "resize: " << size << std::endl;
    T* new_data = new T[size];
    if (data) {
      for(size_t i = 0; i < size_; ++i)
        new_data[i] = data[i];

      delete [] data;
    }

    data = new_data;
  }

  template <typename T>
  void Vector<T>::erase(size_t pos) {

  }
}